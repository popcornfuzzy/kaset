<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.jit</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/Kaset/</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Casting serves the audio stream to the Cast device over the local network. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Casting captures Kaset's own playback with a Core Audio process tap, which the sandbox grants
	     through the audio input entitlement. The system audio recording permission is requested separately
	     via NSAudioCaptureUsageDescription in Info.plist. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
